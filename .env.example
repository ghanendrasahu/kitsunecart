# Copy to .env and fill in only the values you need.
# The platform runs fully offline with the mock providers, so nothing below
# is required for local development or for the test suite. Secrets are
# placeholders - replace them locally and never commit the filled-in file.

# --- Application ----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# --- API auth -------------------------------------------------------------
# When set, /api/v1 requires the X-API-Key header. Leave empty to run
# without auth (development only).
API_KEY=

# Comma-separated list of origins allowed to call the API.
BACKEND_ORIGINS=http://localhost:5173

# --- Storage --------------------------------------------------------------
DATA_DIR=./data
DB_PATH=./data/kitsunecart.db
UPLOAD_DIR=./data/uploads

# --- LLM provider ---------------------------------------------------------
# "groq" calls the real model, "mock" returns deterministic offline output
# (used by the tests).
LLM_PROVIDER=mock
GROQ_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# --- Vision provider ------------------------------------------------------
# "openai" calls the real vision model, "mock" returns deterministic output.
VISION_PROVIDER=mock
OPENAI_API_KEY=
VISION_MODEL=gpt-4o-mini

# --- Marketplace publishing ----------------------------------------------
# The publishers are a sandbox until real seller credentials exist.
MARKETPLACES=amazon_in,flipkart,meesho
PUBLISH_ENABLED=false

# --- Business rules -------------------------------------------------------
DEFAULT_CURRENCY=INR
TARGET_MARGIN_PCT=18.0
MIN_MARGIN_PCT=8.0
SUPPORTED_LANGUAGES=en,hi,mr,ta,te,bn,kn,ml,gu,pa
